PORT=3000
# MongoDB Atlas or a MongoDB replica set; include a database name.
DATABASE_URL="mongodb://127.0.0.1:27017/shellhacks?replicaSet=rs0"
# Server-side key with Places API (New) and Routes API enabled.
GOOGLE_SERVER_KEY=
# Gemini API key (https://aistudio.google.com/apikey) for the AI curb check and plain-English trip requests.
# The Google key above also needs the Street View Static API enabled for the curb check.
GEMINI_API_KEY=
